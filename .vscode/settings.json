{
  // Point at the environment directory rather than a platform-specific
  // executable. The Python extension resolves bin/python on POSIX and
  // Scripts/python.exe on Windows.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.envFile": "${workspaceFolder}/.env",

  // Test configuration for the repository root.
  // Keep discovery centralized here so a single-folder workspace and the
  // provided multi-root workspace both use the same test adapter entrypoint.
  //
  // Run tests via:
  //   1. Testing Explorer (left sidebar) → Run Tests
  //   2. Command Palette (Cmd+Shift+P) → "Test: Run All Tests"
  //   3. Right-click test file/function → Run/Debug
  //
  // Discover both bot and backend tests explicitly from the repository root.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests",
    "web/backend/tests",
    "backend"
  ],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.cwd": "${workspaceFolder}",

  // Pylance type checking configuration
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.useLibraryCodeForTypes": false,

  // Diagnostic severity overrides - suppress noise from third-party stubs
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnknownMemberType": "none",
    "reportUnknownParameterType": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownLambdaType": "none"
  },

  // Add backend to analysis path so editor resolves imports for backend code
  "python.analysis.extraPaths": [
    "web/backend",
    "."
  ],

  // Make terminals (and external agents) see the venv first on PATH for non-interactive runs
  "terminal.integrated.env.linux": {
    "VIRTUAL_ENV": ".venv",
    "PATH": ".venv/bin:${env:PATH}"
  },
  "terminal.integrated.env.windows": {
    "VIRTUAL_ENV": ".venv",
    "PATH": ".venv\\Scripts;${env:PATH}"
  }
}
