{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker Compose (prod-like stack)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd ${workspaceFolder} && docker compose logs -f",
      "preLaunchTask": "docker: compose up (detached)",
      "postDebugTask": "docker: compose down"
    },
    {
      "name": "Docker Compose (follow logs)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd ${workspaceFolder} && docker compose logs -f"
    },
    {
      "name": "pytest (backend integration tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "backend/",
        "-v",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "pytest (all tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "web/backend/tests/",
        "backend/",
        "-v",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Prod-like stack (Docker)",
      "configurations": [
        "Docker Compose (prod-like stack)"
      ],
      "presentation": {
        "hidden": false,
        "group": "Full Stack",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "Prod-like logs only",
      "configurations": [
        "Docker Compose (follow logs)"
      ],
      "presentation": {
        "hidden": false,
        "group": "Full Stack",
        "order": 2
      },
      "stopAll": true
    }
  ]
}
