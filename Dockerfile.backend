FROM node:20-slim AS frontend
WORKDIR /build
COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci
COPY web/frontend/ .
RUN npm run build

FROM python:3.12-slim-bookworm AS builder
WORKDIR /app
COPY web/backend/requirements.txt ./requirements-backend.txt
COPY requirements.txt ./requirements-root.txt
RUN pip install --user --no-cache-dir -r requirements-backend.txt \
	&& pip install --user --no-cache-dir -r requirements-root.txt

FROM python:3.12-slim-bookworm
# Run as a non-root user (security: avoid root inside the container)
RUN groupadd --gid 1000 app && useradd --uid 1000 --gid app --create-home app
WORKDIR /app/web/backend
COPY --from=builder /root/.local /home/app/.local
ENV PATH=/home/app/.local/bin:$PATH
# Copy full project so relative imports (web/backend/core -> services/ etc) work
COPY --chown=app:app . /app
# Copy built frontend dist from the frontend build stage
COPY --from=frontend --chown=app:app /build/dist /app/web/frontend/dist
# Writable mount point for the shared SQLite volume
RUN mkdir -p /app/data && chown -R app:app /app
USER app
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
